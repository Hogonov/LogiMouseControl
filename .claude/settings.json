{
  "permissions": {
    "allow": [
      "Bash(./scripts/test.sh)",
      "Bash(.claude/hooks/test-hooks.sh)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(osascript *)",
      "Bash(cliclick *)",
      "Bash(*setup-local-signing.sh*)",
      "Bash(security *)",
      "Bash(defaults write *)",
      "Bash(defaults delete *)",
      "Bash(defaults import *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.py", "args": [] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "if": "Edit(/Tests/**)", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-test-registration.py", "args": [] }
        ]
      }
    ]
  }
}
