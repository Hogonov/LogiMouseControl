{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.py", "args": [] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "if": "Edit(/Tests/**)", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-test-registration.py", "args": [] }
        ]
      }
    ]
  }
}
