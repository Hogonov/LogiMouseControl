    "namingPatterns": [
      "PascalCase Swift types",
      "camelCase properties and functions",
      "one primary responsibility per source file",
      "domain values represented by named enums and structs",
      "localized user-facing text in Russian",
      "@ViewState alias instead of @State in views"
    ],
    "configFiles": [
      "Package.swift",
      "Resources/Info.plist",
      ".gitignore",
      "AGENTS.md",
      "CLAUDE.md",
      ".claude/settings.json"
    ],
    "testingPattern": "Executable checks built from pure MouseCore logic (MouseCoreChecks, 22 checks) plus fake-dependent Spotlight regression checks (SpotlightShortcutChecks, 8 checks); no XCTest; no automated physical mouse input or assigned actions",
    "verificationCommands": [
      "./scripts/test.sh",
      "swift build --disable-sandbox --scratch-path .build --product LogiMouseControl",
      "./scripts/build.sh",
      "git diff --check",
      "python3 -m json.tool docs/specs/knowledge-graph.json"
    ]
  },
  "architecture": {
    "style": "LAYERED_MODULAR_MONOLITH",
    "layers": [
      "SwiftUI and AppKit presentation",
      "AppModel application coordination",
      "device, scroll, action, ring and recovery services",
      "IOKit and macOS infrastructure adapters",
      "MouseCore protocol and pure domain logic"
    ],
    "targets": [
      {
        "name": "MouseCore",
        "type": "library",
        "path": "Sources/MouseCore",
        "dependsOn": ["Foundation"]
      },
      {
        "name": "LogiMouseControl",
        "type": "executable",
        "path": "Sources/LogiMouseControl",
        "dependsOn": ["MouseCore", "AppKit", "IOKit", "ApplicationServices", "ServiceManagement"],
        "resources": ["DeviceImages"]
      },
      {
        "name": "MouseCoreChecks",
        "type": "executable",
        "path": "Tests/MouseCoreTests",
        "dependsOn": ["MouseCore"]
      },
      {
        "name": "SpotlightShortcutChecks",
        "type": "swiftc outside SwiftPM",
        "path": "Tests/SpotlightShortcutChecks",
        "dependsOn": ["Sources/LogiMouseControl/SpotlightShortcut.swift"],
        "builtBy": "scripts/test.sh"
      }
    ],
    "modules": [
      {
        "name": "MouseCore",
        "responsibilities": [
          "HID++ packet model and response matching",
          "HID++ failure model",
          "control reporting flags",
          "preferences and action models",
          "time-based scroll integration",
          "gesture accumulation",
          "device artwork metadata"
        ]
      },
      {
        "name": "LogiMouseControl",
        "responsibilities": [
          "application lifecycle and UI",
          "device discovery and configuration",
          "macOS event generation",
          "capture recovery and system integration",
          "diagnostic and artwork preview command-line modes"
        ]
      }
    ],
    "patterns": [
      "observable application coordinator",
      "callback-based service boundaries",
      "capability-driven UI and device configuration",
      "single outstanding request with strict response correlation",
      "write then verify for hardware settings",
      "in-memory crash recovery guardian",
      "profile override with general fallback",
      "pure core logic isolated from platform UI"
    ],
    "threading": {
      "main": ["AppModel", "views", "ScrollEngine", "ActionExecutor", "SpotlightShortcut", "RingController", "IOKit callbacks"],
      "local.logimouse.hardware": ["DeviceService state", "HIDTransport.request", "CaptureGuardian"],
      "mainActorAnnotated": false
    },
    "commandLineModes": ["--diagnose", "--render-artwork-preview <directory>", "--recover-on-exit"]
  },
  "domain": {
    "primaryEntities": [
      "DeviceSnapshot",
      "MouseControl",
      "HIDPacket",
      "HIDFailure",
      "Preferences",
      "ScrollPreferences",
      "AppProfile",
      "MouseAction",
      "RingAction",
      "RingApplication",
      "WheelMode",
      "GestureAccumulator",
      "CaptureRecovery"
    ],
    "services": [
      "AppModel",
      "DeviceService",
      "HIDTransport",
      "ScrollEngine",
      "ActionExecutor",
      "RingController",
      "CaptureGuardian",
      "SpotlightShortcut"
    ],
    "stateKinds": {
      "desired": "HardwareView @ViewState before apply",
      "saved": "Preferences.desired* after confirmed write; Preferences.buttons and scroll immediately",
      "confirmed": "DeviceSnapshot for hardware settings; AppModel.appliedScroll, appliedButtons, eventButtons for capture"
    },
    "externalBoundaries": [
      "Logitech MX Master 4 Bluetooth HID++ interface",
      "macOS Accessibility and Input Monitoring",
      "NSWorkspace and symbolic hotkeys",
      "UserDefaults",
      "SMAppService login item",
      "local application bundle resources"
    ]
  },
  "constraints": [
    "Do not simulate mouse-button presses or wheel scrolling during automated verification",
    "Do not execute assigned actions for verification",
    "Do not persist serial numbers, Bluetooth addresses or activity history",
    "Do not claim hardware behavior is verified before user device testing",
    "Do not enable unsupported control flags or capabilities",
    "Do not add network or telemetry behavior without an explicit architecture decision",
    "Keep previously saved preferences.v1 decodable",
    "Do not change bundle identifier, signing identifier or certificate without an ADR"
